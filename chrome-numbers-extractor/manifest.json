{
  "manifest_version": 3,
  "name": "מחלץ מספרים לגיליון / Numbers → Sheet",
  "version": "1.0.0",
  "description": "מעתיק את כל המספרים בדף לפי סדר הופעתם ומזין אותם לעמודה נבחרת ב-Google Sheets או בקובץ Excel. Copy every number on the page into a chosen column of Google Sheets or an Excel file.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "מחלץ מספרים לגיליון",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
